    {
      "id": "7VwV8xvE4MhODrVk3mGUQ",
      "type": "text",
      "x": 6512.640630378431,
      "y": 2188.7073886016974,
      "width": 787.8400740321088,
      "height": 70,
      "angle": 0,
      "strokeColor": "#0c8599",
