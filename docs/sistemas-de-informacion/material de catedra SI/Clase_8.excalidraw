    {
      "id": "mrPQQkqb95ovZwX4d3ecR",
      "type": "text",
      "x": 4820.898501098994,
      "y": 2051.844222184035,
      "width": 862.8401503260541,
      "height": 105,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "T2PEssWN0qbQPajfE_wuI"
      ],
      "frameId": null,
      "index": "bUd",
      "roundness": null,
      "seed": 1011543192,
      "version": 1857,
      "versionNonce": 33575832,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790032385364,
      "created": 1790030517176,
      "link": null,
      "locked": true,
      "text": "Un Bounded Context o contexto delimitado establece un límite\ndentro del cual un determinado modelo y lenguaje tienen un\nsignificado coherente.",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un Bounded Context o contexto delimitado establece un límite dentro del cual un determinado modelo y lenguaje tienen un significado coherente.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "YftrHivPoEptCpNVcQtVu",
      "type": "text",
      "x": 4820.898500801664,
      "y": 2223.6569386295596,
      "width": 862.8401503260541,
      "height": 105,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "T2PEssWN0qbQPajfE_wuI"
      ],
      "frameId": null,
      "index": "bUdG",
      "roundness": null,
      "seed": 1114741144,
      "version": 2344,
      "versionNonce": 1536315880,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790032385364,
      "created": 1790030517176,
      "link": null,
      "locked": true,
      "text": "Bounded Contexts diferentes pueden compartir conceptos y\nno sus significados. Ambos pueden ser modelos perfectamente\nválidos porque están intentando resolver problemas diferentes.",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bounded Contexts diferentes pueden compartir conceptos y no sus significados. Ambos pueden ser modelos perfectamente válidos porque están intentando resolver problemas diferentes.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
