      "version": 2799,
      "versionNonce": 38604520,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790032954853,
      "created": 1790032382199,
      "link": null,
      "locked": true,
      "text": "Las partes de un dominio están relacionadas y sus límites\nno significan aislamiento.",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Las partes de un dominio están relacionadas y sus límites no significan aislamiento.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
