    {
      "id": "bghAN5EtYCFH6tGqoV7r0",
      "type": "text",
      "x": 6473.124490292951,
      "y": 1919.2881585270197,
      "width": 862.8401503260541,
      "height": 105,
      "angle": 0,
      "strokeColor": "#0c8599",
