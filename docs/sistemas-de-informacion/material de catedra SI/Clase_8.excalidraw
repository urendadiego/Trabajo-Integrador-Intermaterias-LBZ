      "version": 579,
      "versionNonce": 1891114984,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790034106629,
      "created": 1790033249576,
      "link": null,
      "locked": true,
      "text": "Con DDD evitamos:\n- Conceptos ambiguos\n- Malinterpretaciones\n- Modelos complejos difíciles de comprender y manejar\n- Soluciones de mala calidad, inútiles",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Con DDD evitamos:\n- Conceptos ambiguos\n- Malinterpretaciones\n- Modelos complejos difíciles de comprender y manejar\n- Soluciones de mala calidad, inútiles",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "gw9Ge7J_m1mAYY3YdP2Wl",
      "type": "text",
