      "link": null,
      "locked": true,
      "text": "¿Por qué necesitamos DDD?",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "¿Por qué necesitamos DDD?",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "4h9s05wRFFPNEZHe1L47B",
      "type": "line",
      "x": 3193.7207088214896,
      "y": -350.12532120744686,
      "width": 476.4039666032795,
      "height": 1.1368683772161603e-13,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#e9ecef",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "4tiguvZzGmHjyHfDXv69m"
      ],
