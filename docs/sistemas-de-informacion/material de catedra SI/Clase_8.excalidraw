      "type": "text",
      "x": 4860.414641184472,
      "y": 2421.117376045422,
      "width": 787.8400740321088,
      "height": 70,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
