    {
      "id": "udXtfMqSXYH_N51FHp3sB",
      "type": "text",
      "x": 5467.002372395138,
      "y": 1124.5744514833336,
      "width": 404.4793701171875,
      "height": 150,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "QAVsPMVLbgN7gLonoC23t"
      ],
      "frameId": null,
      "index": "bWC",
      "roundness": null,
      "seed": 1522506847,
      "version": 539,
      "versionNonce": 1571992040,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790034097974,
      "created": 1789944076840,
      "link": null,
      "locked": true,
      "text": "¿Qué sistema vamos a diseñar?\n¿Qué responsabilidades tendrá?\n¿Cómo representaremos esos conceptos?\n¿Qué información gestionará?\n¿Qué partes del problema resolveremos\nmediante software?",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "¿Qué sistema vamos a diseñar?\n¿Qué responsabilidades tendrá?\n¿Cómo representaremos esos conceptos?\n¿Qué información gestionará?\n¿Qué partes del problema resolveremos mediante software?",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "lD77SgmsAAab1-kwv8nz4",
      "type": "text",
      "x": 4805.85041978102,
      "y": 1124.5744518622398,
      "width": 385.3993530273438,
      "height": 200,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "QAVsPMVLbgN7gLonoC23t"
      ],
      "frameId": null,
      "index": "bWD",
      "roundness": null,
      "seed": 1867321201,
      "version": 544,
      "versionNonce": 293060760,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790034097974,
      "created": 1789944082615,
      "link": null,
      "locked": true,
      "text": "¿Cómo funciona el negocio?\n¿Qué quiere conseguir la organización?\n¿Qué problemas tiene?\n¿Qué actores participan?\n¿Qué reglas existen?\n¿Qué información necesitan?\n¿Qué significa exactamente un pedido,\nuna entrega o el stock disponible?",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "¿Cómo funciona el negocio?\n¿Qué quiere conseguir la organización?\n¿Qué problemas tiene?\n¿Qué actores participan?\n¿Qué reglas existen?\n¿Qué información necesitan?\n¿Qué significa exactamente un pedido, una entrega o el stock disponible?",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
