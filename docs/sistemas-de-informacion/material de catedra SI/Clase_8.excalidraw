    {
      "id": "W4T-KGV8MG2TPdGcPz1St",
      "type": "text",
      "x": 6953.816926574874,
      "y": 993.8534620602233,
      "width": 404.4793701171875,
      "height": 150,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bV5",
      "roundness": null,
      "seed": 932130536,
      "version": 350,
      "versionNonce": 1958064872,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1790032305415,
      "created": 1790032304015,
      "link": null,
      "locked": false,
      "text": "¿Qué sistema vamos a diseñar?\n¿Qué responsabilidades tendrá?\n¿Cómo representaremos esos conceptos?\n¿Qué información gestionará?\n¿Qué partes del problema resolveremos\nmediante software?",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "¿Qué sistema vamos a diseñar?\n¿Qué responsabilidades tendrá?\n¿Cómo representaremos esos conceptos?\n¿Qué información gestionará?\n¿Qué partes del problema resolveremos mediante software?",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "et-T2rFcyZCVhXTZNEodz",
      "type": "text",
      "x": 6292.664973960756,
      "y": 993.8534624391292,
      "width": 385.3993530273438,
      "height": 200,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bV6",
      "roundness": null,
      "seed": 1989743080,
      "version": 352,
      "versionNonce": 551636888,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1790032305415,
      "created": 1790032304015,
      "link": null,
      "locked": false,
      "text": "¿Cómo funciona el negocio?\n¿Qué quiere conseguir la organización?\n¿Qué problemas tiene?\n¿Qué actores participan?\n¿Qué reglas existen?\n¿Qué información necesitan?\n¿Qué significa exactamente un pedido,\nuna entrega o el stock disponible?",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "¿Cómo funciona el negocio?\n¿Qué quiere conseguir la organización?\n¿Qué problemas tiene?\n¿Qué actores participan?\n¿Qué reglas existen?\n¿Qué información necesitan?\n¿Qué significa exactamente un pedido, una entrega o el stock disponible?",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
