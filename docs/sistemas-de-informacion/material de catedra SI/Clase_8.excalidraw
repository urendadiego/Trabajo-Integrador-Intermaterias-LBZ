      "id": "19JLR8F2le2N2Yytvu5xN",
      "type": "text",
      "x": 5075.789250893674,
      "y": 1388.9744277983445,
      "width": 520.0740966796875,
      "height": 70,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
