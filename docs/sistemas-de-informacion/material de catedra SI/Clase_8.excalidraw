    {
      "id": "08r6JjI1puJDymaldAhTJ",
      "type": "text",
      "x": 4805.850420389699,
      "y": 834.2737949063171,
      "width": 1065.6313226103016,
      "height": 105,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#e9ecef",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "QAVsPMVLbgN7gLonoC23t"
      ],
      "frameId": null,
      "index": "bWF",
      "roundness": null,
      "seed": 1177607064,
      "version": 190,
      "versionNonce": 48491928,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790034097974,
      "created": 1790033948631,
      "link": null,
      "locked": true,
      "text": "Un espacio es un ámbito conceptual dentro del cual agrupamos ciertos\nelementos, preguntas y decisiones relacionadas. Es una separación abstracta\nde distintos tipos de análisis para no mezclarlos.",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un espacio es un ámbito conceptual dentro del cual agrupamos ciertos elementos, preguntas y decisiones relacionadas. Es una separación abstracta de distintos tipos de análisis para no mezclarlos.",
      "autoResize": false,
