      "seed": 898600856,
      "version": 2659,
      "versionNonce": 339727592,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790032385364,
      "created": 1790031444626,
      "link": null,
      "locked": true,
      "text": "Es importante no mezclar modelos, evitar interferencias\nentre Bounded Contexts.",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Es importante no mezclar modelos, evitar interferencias entre Bounded Contexts.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
