    {
      "id": "1NgeewbR8LhtEaj757J9e",
      "type": "line",
      "x": 3327.121459058998,
      "y": 789.9067070164504,
      "width": 210.66670735677098,
      "height": 0,
      "angle": 0,
      "strokeColor": "#e8590c",
      "backgroundColor": "#ffd8a8",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "d5T8uGYsT45eH2K4A5LTe"
      ],
