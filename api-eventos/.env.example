PORT=3000
FRONTEND_URL=http://localhost:5173

# Base compartida del grupo en Supabase (pedirla por privado). Session pooler.
DATABASE_URL=postgresql://postgres.xxxx:CONTRASEÑA@aws-1-us-west-2.pooler.supabase.com:5432/postgres

# Sin DATABASE_URL se usan estas (Postgres local o en Docker)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=backstage

# Clave para firmar los tokens de sesión. Cualquier texto largo y secreto;
# todas las réplicas de la API tienen que usar la misma.
JWT_SECRET=cambiar-por-un-texto-largo-y-secreto
JWT_EXPIRA=8h

# Gmail para mandar el código de verificación del email (opcional).
# GMAIL_CLAVE_APP es una "contraseña de aplicación" de Google (16 letras), no la contraseña de la cuenta.
# Si no están, el mail no se manda y el código aparece en la consola de la API.
GMAIL_USUARIO=
GMAIL_CLAVE_APP=
