      "x": 3031.6422117297793,
      "y": 179.66058223538153,
      "width": 816.3035519763888,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#99e9f2",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "4tiguvZzGmHjyHfDXv69m"
