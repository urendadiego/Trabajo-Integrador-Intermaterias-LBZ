      "version": 741,
      "versionNonce": 363513320,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790031701151,
      "created": 1789943617921,
      "link": null,
      "locked": true,
      "text": "El dominio es el área de actividad, conocimiento y problemas\nsobre la cual estamos trabajando.",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "El dominio es el área de actividad, conocimiento y problemas sobre la cual estamos trabajando.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "8APD0uRAEgvrSB8quBaxs",
      "type": "text",
      "x": 667.8201570962595,
      "y": 821.8469458808393,
      "width": 901.0354003906251,
      "height": 140,
      "angle": 0,
      "strokeColor": "#6741d9",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "8bYHA5CtOEgAyV8ttfrO6"
      ],
      "frameId": null,
      "index": "bTZ",
      "roundness": null,
      "seed": 1315970193,
      "version": 571,
      "versionNonce": 1168601496,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790031690462,
      "created": 1789944292942,
      "link": null,
      "locked": true,
      "text": "Se traduce como Diseño Dirigido por el Dominio. Es un enfoque\nque propone colocar el conocimiento del dominio en el centro del\nproceso de diseño e implementación del software, de manera que la\nsolución refleje adecuadamente el problema a resolver.",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Se traduce como Diseño Dirigido por el Dominio. Es un enfoque que propone colocar el conocimiento del dominio en el centro del proceso de diseño e implementación del software, de manera que la solución refleje adecuadamente el problema a resolver.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
