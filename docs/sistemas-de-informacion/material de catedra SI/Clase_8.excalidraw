      "seed": 1455802344,
      "version": 2074,
      "versionNonce": 1803368856,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790032954853,
      "created": 1790032382199,
      "link": null,
      "locked": true,
      "text": "Los contextos no están aislados. Existen relaciones entre\nellos para intercambiar información y lograr el funcionamiento\ngeneral del dominio.",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Los contextos no están aislados. Existen relaciones entre ellos para intercambiar información y lograr el funcionamiento general del dominio.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "duiT4blo6d2PG9C99n8T9",
      "type": "text",
      "x": 6473.124489995621,
      "y": 2055.7307578408577,
      "width": 862.8401503260541,
      "height": 70,
      "angle": 0,
      "strokeColor": "#0c8599",
      "backgroundColor": "#99e9f2",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "H8THQb-IDHv8zcdQTN5Wt"
      ],
      "frameId": null,
      "index": "bVQ",
      "roundness": null,
      "seed": 93620968,
      "version": 2520,
      "versionNonce": 20892648,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790032954853,
      "created": 1790032382199,
      "link": null,
      "locked": true,
      "text": "El Context Map o mapa de contextos nos permite visualizar\nqué Bounded Contexts existen y cómo se relacionan entre sí.",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "El Context Map o mapa de contextos nos permite visualizar qué Bounded Contexts existen y cómo se relacionan entre sí.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "WpdAG0cQKNLL4yyxAHDxs",
