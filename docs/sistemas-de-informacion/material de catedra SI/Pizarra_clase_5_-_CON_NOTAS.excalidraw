        }
      ],
      "updated": 1788223421985,
      "link": null,
      "locked": false,
      "text": "Con la IA es más sencillo procesarlos. OJO: no\nresuelve problemas de trazabilidad, privacidad,\nconfiabilidad, etc.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Con la IA es más sencillo procesarlos. OJO: no resuelve problemas de trazabilidad, privacidad, confiabilidad, etc.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "7GY1vTUh5g1jq6MIiHuvv",
      "type": "text",
      "x": 3406.6419433291226,
      "y": -918.386737031984,
      "width": 367.02257545293423,
      "height": 40,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b45N",
      "roundness": null,
      "seed": 783967137,
      "version": 418,
      "versionNonce": 811272651,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "qcV2pm90vcj2fig7bzU-A",
          "type": "arrow"
        }
      ],
      "updated": 1788223421985,
      "link": null,
      "locked": false,
      "text": "Un dato puede ser correcto y aun así producir\ninformación poco útil.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un dato puede ser correcto y aun así producir información poco útil.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "LBGnbfjPiOzxXZ0rSxS5u",
      "type": "text",
      "x": 3784.2688005538225,
      "y": 475.64171156451005,
      "width": 1001.5079345703125,
      "height": 210,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b45O",
      "roundness": null,
      "seed": 66891937,
      "version": 673,
      "versionNonce": 337500274,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "zOriqRgn75f20ABPx05dM",
          "type": "arrow"
        }
      ],
      "updated": 1788387885056,
      "link": null,
      "locked": false,
      "text": "Como analistas podemos:\n1. Detectar el problema\n2. Determinar dónde se origina\n3. Analizar sus consecuencias\n4. Proponer cambios en procesos, responsabilidades, controles o software\n5. Implementar en software aquello que corresponda.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Como analistas podemos:\n1. Detectar el problema\n2. Determinar dónde se origina\n3. Analizar sus consecuencias\n4. Proponer cambios en procesos, responsabilidades, controles o software\n5. Implementar en software aquello que corresponda.",
      "autoResize": true,
      "lineHeight": 1.25
    },
