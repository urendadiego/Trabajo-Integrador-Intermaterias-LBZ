# Variables para docker compose. Copiar a .env en la raíz del repo, en cada PC.
# El .env NO se commitea. JWT_SECRET tiene que ser IGUAL en las 3 PCs (un token firmado por una réplica lo valida otra).

# Base (Postgres corre en la PC 1; las api de las 3 PCs se conectan con estos datos)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_esta_contraseña
POSTGRES_DB=backstage

# API (las 3 PCs)
JWT_SECRET=cambiar_por_un_texto_largo_y_aleatorio
JWT_EXPIRA=8h
GMAIL_USUARIO=
GMAIL_CLAVE_APP=

# Opcionales: si no están, valen los valores por defecto escritos en los compose.
# IPs de las 3 PCs en la red local (PC 1 = acceso: además de front y api, corre nginx y la base)
# IP_PC1=192.168.0.10
# IP_PC2=192.168.0.11
# IP_PC3=192.168.0.12

# Nombre de la réplica de esta PC: api1 en la PC 1, api2 en la PC 2, api3 en la PC 3
INSTANCIA=api1

# Solo en la PC 1 (descomentar): el puerto 80 lo usa el balanceador, así que el front de la PC 1 no puede usarlo.
# En la PC 2 y la PC 3 dejarlo comentado: el front queda en el 80 y se entra con http://IP-de-la-PC
# PUERTO_WEB=8081
